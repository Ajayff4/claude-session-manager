{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (isolated settings)",
      "type": "extensionHost",
      "request": "launch",
      // Own user-data-dir: profile switches in the dev window don't touch your real VS Code settings.
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--user-data-dir=${workspaceFolder}/.vscode-dev-data"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    }
  ]
}
